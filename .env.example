# Copia este archivo a ".env" y rellena los valores.
# El ".env" real NO se sube a git. Nunca subas claves o contraseñas.

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=genera-una-clave-aleatoria

# "True" en desarrollo, "False" en producción
DJANGO_DEBUG=True

# Hosts permitidos, separados por coma
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Conexión PostgreSQL (si la dejas vacía, se usa SQLite local)
DATABASE_URL=

# Dominios de correo permitidos para registrarse o entrar con Google
DJANGO_EMAIL_DOMAINS=unal.edu.co

# Correos que se convierten en administradores automáticamente (separados por coma)
DJANGO_ADMIN_EMAILS=tu.correo@unal.edu.co

# OAuth de Google (opcional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Correo para notificaciones. Prioridad:
#   1) RESEND_API_KEY (HTTPS — funciona en Render gratis; recomendado)
#   2) SMTP_HOST + SMTP_USER (SMTP clásico; Render gratis lo bloquea)
#   3) ninguno -> consola (se imprime en la terminal local)
RESEND_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT=10
DEFAULT_FROM_EMAIL=kevin.ralu22@gmail.com

# URL pública del sitio (se usa para los enlaces de los correos)
SITE_URL=http://127.0.0.1:8000